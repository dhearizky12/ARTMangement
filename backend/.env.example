# Backend local development (.env lokal, JANGAN commit).
# Cara pakai: backend TIDAK membaca .env otomatis. Untuk `dotnet run`,
# export manual dulu, misal:
#   set -a; source backend/.env; set +a
#   dotnet run --project backend/BantuBantu.Api
# Kalau pakai docker compose, abaikan file ini dan isi root .env saja.
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080
FRONTEND_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:5080
ALLOWED_HOSTS=localhost

# Database Neon (ambil dari dashboard Neon).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require

# Google OAuth (Client ID yang sama dipakai frontend).
GOOGLE_CLIENT_ID=
JWT_ISSUER=http://localhost:5080
JWT_AUDIENCE=bantu-bantu-web
JWT_KEY_ID=docker-local-v1
# Untuk dotnet run: arahkan ke file key lokal (atau isi JWT_PRIVATE_KEY_BASE64).
# Jwt__PrivateKeyPath / Jwt__PublicKeyPath dibaca sebagai Jwt:PrivateKeyPath (format __).
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Storage lokal.
STORAGE_PROVIDER=Local

# --- Email lokal via Mailpit (SMTP simulator, tanpa auth/TLS) ---
# Selama Email:Smtp:Host diisi, backend Development mengirim via SMTP ini
# (bukan via logging, bukan via Resend). Lihat hasilnya di http://localhost:8025.
# Kosongkan EMAIL_SMTP_HOST untuk kembali ke mode logging-only.
# Format .NET: Email__Smtp__Host dibaca sebagai Email:Smtp:Host.
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_FROM=Bantu-Bantu <no-reply@localhost>

# --- 2FA email-code (default mati lokal) ---
TWO_FACTOR_ENABLED=false

# --- Notifikasi transaksional (default mati lokal) ---
NOTIFICATIONS_ENABLED=false
EMAIL_REPLY_TO=

# --- Frontend base URL untuk link di email (default = FRONTEND_ORIGIN) ---
APP_FRONTEND_BASE_URL=
