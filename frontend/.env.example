# Frontend local development. Copy to frontend/.env for `npm run dev`
# (Vite reads frontend/.env automatically; this example file is not loaded).
# Backend lokal default: http://localhost:5080 (docker compose / dotnet run).
VITE_API_BASE_URL=http://localhost:5080
# Google OAuth Client ID — WAJIB sama dengan GOOGLE_CLIENT_ID backend.
VITE_GOOGLE_CLIENT_ID=
