# Docker Compose config. Copy to .env in this directory; do not commit .env.
# localhost URLs are used by the BROWSER, not Docker service names.
FRONTEND_PORT=5173
API_PORT=5080
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma/semicolon-separated additional exact origins and HTTPS preview patterns.
FRONTEND_ORIGINS=
FRONTEND_ORIGIN_PATTERNS=
API_BASE_URL=http://localhost:5080

# Local uses the Docker volume `document_data`. Render should use S3/R2.
STORAGE_PROVIDER=Local
STORAGE_S3_SERVICE_URL=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=
STORAGE_S3_KEY_PREFIX=provider-documents

# Neon pooled connection for normal API traffic. `neon env pull` writes this
# value to the gitignored `.env` after the workspace is linked.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
# Direct connection for EF migrations and the one-time wilayah seed.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require

# Same Web Client ID is passed to both frontend and backend.
GOOGLE_CLIENT_ID=424501905499-s3h8olcev70edfiro36g7lo7d52cgge1.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
JWT_ISSUER=http://localhost:5080
JWT_AUDIENCE=bantu-bantu-web
JWT_KEY_ID=docker-local-v1
# Render can use base64-encoded PEM values; Docker local uses the mounted key files above.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Local HTTP only. Production requires HTTPS and COOKIE_SECURE=true.
ASPNETCORE_ENVIRONMENT=Development
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
ALLOWED_HOSTS=localhost

# Optional: used only by the explicit admin-seed service.
ADMIN_EMAIL=
ADMIN_PASSWORD=
