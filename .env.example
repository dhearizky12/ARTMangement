# Docker Compose config. Copy to .env in this directory; do not commit .env.
# localhost URLs are used by the BROWSER, not Docker service names.
FRONTEND_PORT=5173
API_PORT=5080
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma/semicolon-separated additional exact origins and HTTPS preview patterns.
FRONTEND_ORIGINS=
FRONTEND_ORIGIN_PATTERNS=
API_BASE_URL=http://localhost:5080

# Local uses the Docker volume `document_data`. Render should use S3/R2.
STORAGE_PROVIDER=Local
STORAGE_S3_SERVICE_URL=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=
STORAGE_S3_KEY_PREFIX=provider-documents

# Neon pooled connection for normal API traffic. `neon env pull` writes this
# value to the gitignored `.env` after the workspace is linked.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
# Direct connection for EF migrations and the one-time wilayah seed.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require

# Same Web Client ID is passed to both frontend and backend.
GOOGLE_CLIENT_ID=424501905499-s3h8olcev70edfiro36g7lo7d52cgge1.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
JWT_ISSUER=http://localhost:5080
JWT_AUDIENCE=bantu-bantu-web
JWT_KEY_ID=docker-local-v1
# Render can use base64-encoded PEM values; Docker local uses the mounted key files above.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Local HTTP only. Production frontend/API origin is configured separately.
ASPNETCORE_ENVIRONMENT=Development
ALLOWED_HOSTS=localhost

# Backend rolling structured logs (used by deploy-be.sh; kept under App_Data on MonsterASP)
LOG_FILE_PATH=App_Data/logs/api
LOG_MINIMUM_LEVEL=Information
LOG_RETAINED_FILES=14
LOG_MAX_FILE_BYTES=10485760

# Optional: used only by the explicit admin-seed service.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Resend email sending (least privilege) ---
# RESEND_MASTER_API_KEY is a FULL-ACCESS key. It lives only in this local .env
# and is read only by scripts/provision-resend-key.sh, which mints the backend's
# separate sending-only key. Never commit it, and never put it in CI,
# web.config, docker-compose, the frontend, or any log.
# RESEND_MASTER_API_KEY=
# Optional: restrict the sending key to one verified Resend domain (domain id).
# RESEND_DOMAIN_ID=
# Sender address on a Resend-verified domain (backend reads it as Resend:From).
# RESEND_FROM=Bantu-Bantu <no-reply@example.com>
# Set to true only where mail is actually sent; the backend and deploy-be.sh
# then REQUIRE Resend:ApiKey (provisioned by scripts/provision-resend-key.sh).
# EMAIL_VERIFICATION_ENABLED=false

# --- Local mail simulator (Mailpit, via docker compose) ---
# Selama backend melihat Email:Smtp:Host, email Development dikirim ke Mailpit
# (SMTP tanpa auth/TLS) dan bisa dilihat di http://localhost:8025 — bukan via
# logging, bukan via Resend. Compose sudah menyetel host mailpit + port 1025.
# Alamat pengirim lokal (boleh apa saja di simulator).
# EMAIL_SMTP_FROM=Bantu-Bantu <no-reply@localhost>

# --- Email-code 2FA for admin/provider logins ---
# TWO_FACTOR_ENABLED=false requires this repo variable flag in CI (defaults off).
# Do NOT enable it until RESEND_FROM + the sending-only Resend key are in place:
# both deploy-be.sh and Program.cs fail fast when it is on without them.
# TWO_FACTOR_ENABLED=false
# Provider logins may pick "use password instead" (limited session). Skips are
# rate-limited per hour; only affects provider logins when false forces a code.
# TWO_FACTOR_PROVIDER_PASSWORD_FALLBACK=true
# Code lifetime in minutes (2-30). Resend cooldown must be shorter than this.
# TWO_FACTOR_CODE_TTL_MINUTES=10
# Wrong tries before a challenge locks (3-10).
# TWO_FACTOR_MAX_ATTEMPTS=5
# Seconds to wait before asking for a new code (30-300, must be < TTL*60).
# TWO_FACTOR_RESEND_COOLDOWN_SECONDS=60
# Resend requests allowed per account per hour (1-20).
# TWO_FACTOR_MAX_RESENDS_PER_HOUR=5
# Password-fallback (skip) sessions allowed per provider per hour (1-10).
# TWO_FACTOR_MAX_SKIPS_PER_HOUR=3

# --- Transactional email notifications (outbox) ---
# NOTIFICATIONS_ENABLED=false requires this repo variable flag in CI (defaults off).
# Do NOT enable Notifications until RESEND_FROM + the sending-only Resend key are in place:
# both deploy-be.sh and Program.cs fail fast when it is on without them.
# NOTIFICATIONS_ENABLED=false
# Seconds between outbox poller runs (5-300).
# NOTIFICATIONS_OUTBOX_POLL_SECONDS=30
# Send attempts per Notifications email before it is marked Failed (1-10). Backoff is
# 15m/30m/1h/2h/4h/8h, so six attempts span roughly a day (see EmailOutboxWorker.RetryDelay).
# NOTIFICATIONS_MAX_ATTEMPTS=6
# Hourly Notifications cap: max emails per recipient + event before suppression (1-100).
# NOTIFICATIONS_MAX_PER_RECIPIENT_PER_HOUR=10
# Total seconds the post-commit send may take before leaving rows Pending (1-30).
# NOTIFICATIONS_OPPORTUNISTIC_TIMEOUT_SECONDS=2
# Optional reply-to / support address in the email footer; empty omits the line.
# EMAIL_REPLY_TO=
# App base URL used to build Notifications email links; defaults to FRONTEND_ORIGIN.
# APP_FRONTEND_BASE_URL=
